rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOrderCode(code) {
      return code is string && code.size() == 14 && code.matches('^SUFI-[A-Z0-9]{4}-[A-Z0-9]{4}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'hajshdbdb262837@gmail.com';
    }

    // 3. Entity Validation Blueprints
    function isValidAdmin(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidCourseSettings(data) {
      return data.keys().hasAll([
          'courseName', 'courseDescription', 'courseCoverUrl',
          'originalPrice', 'showOriginalPrice', 'coursePrice',
          'upiId', 'qrCodeUrl', 'whatsappNumber', 'isAvailable', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'courseName', 'courseDescription', 'courseCoverUrl',
          'originalPrice', 'showOriginalPrice', 'coursePrice',
          'upiId', 'qrCodeUrl', 'whatsappNumber', 'isAvailable', 'updatedAt'
        ])
        && data.courseName is string && data.courseName.size() >= 2 && data.courseName.size() <= 150
        && data.courseDescription is string && data.courseDescription.size() >= 5 && data.courseDescription.size() <= 1000
        && data.courseCoverUrl is string && data.courseCoverUrl.size() <= 2048
        && data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 1000000
        && data.showOriginalPrice is bool
        && data.coursePrice is number && data.coursePrice >= 1 && data.coursePrice <= 1000000
        && data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 120
        && data.qrCodeUrl is string && data.qrCodeUrl.size() <= 2048
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 25
        && data.isAvailable is bool
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data, code) {
      return data.keys().hasAll([
          'orderCode', 'name', 'mobile', 'utr', 'screenshotUrl',
          'amount', 'status', 'rejectionReason', 'adminId',
          'createdAt', 'approvedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderCode', 'name', 'mobile', 'utr', 'screenshotUrl',
          'amount', 'status', 'rejectionReason', 'adminId',
          'createdAt', 'approvedAt', 'updatedAt'
        ])
        && data.orderCode is string && data.orderCode == code && isValidOrderCode(data.orderCode)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 15 && data.mobile.matches('^[0-9+\\-\\s]{10,15}$')
        && data.utr is string && data.utr.size() >= 6 && data.utr.size() <= 40 && data.utr.matches('^[A-Z0-9]{6,40}$')
        && data.screenshotUrl is string && data.screenshotUrl.size() >= 5 && data.screenshotUrl.size() <= 2048
        && data.amount is number && data.amount >= 1 && data.amount <= 1000000
        && data.status in ['PENDING', 'APPROVED', 'REJECTED']
        && data.rejectionReason is string && data.rejectionReason.size() <= 500
        && data.adminId is string && data.adminId.size() <= 128
        && data.createdAt is timestamp
        && (data.approvedAt == null || data.approvedAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidOrderTracking(data, code) {
      return data.keys().hasAll(['orderCode', 'amount', 'status', 'rejectionReason', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['orderCode', 'amount', 'status', 'rejectionReason', 'createdAt', 'updatedAt'])
        && data.orderCode is string && data.orderCode == code && isValidOrderCode(data.orderCode)
        && data.amount is number && data.amount >= 1 && data.amount <= 1000000
        && data.status in ['PENDING', 'APPROVED', 'REJECTED']
        && data.rejectionReason is string && data.rejectionReason.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUtrLock(data, utrId) {
      return data.keys().hasAll(['utr', 'orderCode', 'createdAt'])
        && data.keys().hasOnly(['utr', 'orderCode', 'createdAt'])
        && data.utr is string && data.utr == utrId && data.utr.size() >= 6 && data.utr.size() <= 40 && data.utr.matches('^[A-Z0-9]{6,40}$')
        && data.orderCode is string && isValidOrderCode(data.orderCode)
        && data.createdAt is timestamp;
    }

    function isValidAccessGrant(data, code) {
      return data.keys().hasAll(['orderCode', 'grantedAt'])
        && data.keys().hasOnly(['orderCode', 'grantedAt'])
        && data.orderCode is string && data.orderCode == code && isValidOrderCode(data.orderCode)
        && data.grantedAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(userId)
        && isValidAdmin(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(userId)
        && isValidAdmin(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /settings/{settingId} {
      allow get: if settingId == 'course';
      allow list: if false;
      allow create: if isAdmin()
        && settingId == 'course'
        && isValidCourseSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && settingId == 'course'
        && isValidCourseSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Orders contain customer PII (name, mobile, utr, screenshot) -> strictly Admin read/update only
    match /orders/{orderCode} {
      allow get: if isAdmin() && isValidOrderCode(orderCode);
      allow list: if isAdmin();
      allow create: if isValidOrderCode(orderCode)
        && isValidOrder(incoming(), orderCode)
        && incoming().status == 'PENDING'
        && incoming().rejectionReason == ''
        && incoming().adminId == ''
        && incoming().approvedAt == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/utr_locks/$(incoming().utr))
        && existsAfter(/databases/$(database)/documents/utr_locks/$(incoming().utr))
        && existsAfter(/databases/$(database)/documents/order_tracking/$(orderCode));
      allow update: if isAdmin()
        && isValidOrderCode(orderCode)
        && isValidOrder(incoming(), orderCode)
        && existing().status != 'APPROVED'
        && incoming().orderCode == existing().orderCode
        && incoming().name == existing().name
        && incoming().mobile == existing().mobile
        && incoming().utr == existing().utr
        && incoming().screenshotUrl == existing().screenshotUrl
        && incoming().amount == existing().amount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().adminId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminId', 'approvedAt', 'rejectionReason', 'updatedAt'])
        && (
          (incoming().status == 'APPROVED' && incoming().approvedAt == request.time && incoming().rejectionReason == '') ||
          (incoming().status == 'REJECTED' && incoming().approvedAt == null && incoming().rejectionReason.size() >= 3)
        );
      allow delete: if false;
    }

    // PII-free tracking status split collection keyed by unguessable cryptographically random orderCode
    match /order_tracking/{orderCode} {
      allow get: if isValidOrderCode(orderCode);
      allow list: if false;
      allow create: if isValidOrderCode(orderCode)
        && isValidOrderTracking(incoming(), orderCode)
        && incoming().status == 'PENDING'
        && incoming().rejectionReason == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(orderCode));
      allow update: if isAdmin()
        && isValidOrderCode(orderCode)
        && isValidOrderTracking(incoming(), orderCode)
        && existing().status != 'APPROVED'
        && incoming().orderCode == existing().orderCode
        && incoming().amount == existing().amount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason', 'updatedAt'])
        && (
          (incoming().status == 'APPROVED' && incoming().rejectionReason == '') ||
          (incoming().status == 'REJECTED' && incoming().rejectionReason.size() >= 3)
        );
      allow delete: if false;
    }

    match /utr_locks/{utrId} {
      allow get: if isValidId(utrId);
      allow list: if false;
      allow create: if isValidId(utrId)
        && isValidUtrLock(incoming(), utrId)
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderCode));
      allow update: if false;
      allow delete: if isAdmin() && isValidId(utrId);
    }

    // Single-use Telegram invite issuance lock per approved orderCode
    match /access_grants/{orderCode} {
      allow get: if isValidOrderCode(orderCode);
      allow list: if false;
      allow create: if isValidOrderCode(orderCode)
        && isValidAccessGrant(incoming(), orderCode)
        && incoming().grantedAt == request.time
        && get(/databases/$(database)/documents/order_tracking/$(orderCode)).data.status == 'APPROVED';
      allow update: if false;
      allow delete: if isAdmin() && isValidOrderCode(orderCode);
    }
  }
}
